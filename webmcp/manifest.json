      "name": "gateway_inspect_session",
      "title": "Gateway Inspect Session",
      "description": "Inspect the current sanitized SecuredMe Education session v2.",
      "mode": "READ",
      "availability": "available",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "status",
          "tool",
          "data",
          "secret_values_exposed"
        ],
        "properties": {
          "status": {
            "const": "success"
          },
          "tool": {
            "const": "gateway_inspect_session"
          },
          "data": {},
          "secret_values_exposed": {
            "const": false
          }
        },
        "additionalProperties": false
      },
      "handler": {
        "kind": "local",
        "operation": "IdentityStore.get_session"
      }
    },
