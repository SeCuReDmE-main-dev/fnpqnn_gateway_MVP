# SecuredMe Auth0 development tenant (values are supplied through Settings)
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://gateway.securedme.ca/api
AUTH0_CALLBACK_URL=https://gateway-dev.securedme.ca/auth/callback
AUTH0_LOGOUT_URL=https://gateway-dev.securedme.ca/
AUTH0_ORGANIZATION_ID=
AUTH0_ALLOWED_AMR=pwd,mfa,federated,passkey
AUTH0_ALLOWED_SUBJECT_PREFIXES=auth0
AUTH0_ALLOW_DELETE=false
AUTH0_DEPLOY_CLIENT_ID=
AUTH0_DEPLOY_CLIENT_SECRET=
AUTH0_TENANT_ENVIRONMENT=Development
AUTH0_SYNTHETIC_CONNECTION=Username-Password-Authentication

# Internal session boundary
SECUREDME_IDENTITY_DB=.fnpqnn_gateway/identity.sqlite3
SECUREDME_AUTH_ALLOWED_RETURN_URLS=https://algoquest-dev.securedme.ca/,https://synthia-dev.securedme.ca/
SECUREDME_AUTH_ALLOWED_ORIGINS=https://algoquest-dev.securedme.ca,https://synthia-dev.securedme.ca
SECUREDME_ALLOW_LEGACY_IDENTITY_HEADER_FOR_TESTS=false
