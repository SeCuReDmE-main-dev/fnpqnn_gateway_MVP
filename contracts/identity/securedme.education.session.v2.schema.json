{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gateway.securedme.ca/contracts/securedme.education.session.v2.schema.json",
  "title": "SecuredMe Education Session v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session_id", "identity_ref", "role", "age_band", "surface", "authority_ref", "subject_ref", "assigned_class_refs", "consent_scope", "allowed_tools", "authorization_basis", "auth_time", "expires_at", "csrf_token", "contract_version", "raw_secret_stored"],
  "properties": {
    "schema": {"const": "securedme.education.session.v2"},
    "session_id": {"type": "string", "pattern": "^session_[A-Za-z0-9_-]{16,80}$"},
    "identity_ref": {"type": "string", "pattern": "^idref_[a-f0-9]{32}$"},
    "role": {"enum": ["student_minor", "student_adult", "teacher", "privacy_admin", "school_admin", "unassigned"]},
    "age_band": {"type": "string", "maxLength": 40},
    "surface": {"enum": ["student", "teacher", "governance", "unauthorized"]},
    "authority_ref": {"type": "string", "pattern": "^authority_[A-Za-z0-9_-]{3,80}$"},
    "subject_ref": {"type": "string", "maxLength": 100},
    "assigned_class_refs": {"type": "array", "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "maxLength": 100}},
    "consent_scope": {"enum": ["none", "tool", "suite"]},
    "allowed_tools": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]{2,60}$"}},
    "authorization_basis": {"$ref": "securedme.authorization_basis.v1.schema.json"},
    "auth_time": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "csrf_token": {"type": "string", "minLength": 32, "maxLength": 160},
    "contract_version": {"const": "v2"},
    "raw_secret_stored": {"const": false}
  }
}
