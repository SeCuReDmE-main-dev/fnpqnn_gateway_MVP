{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scholarium.securedme.ca/schemas/securedme.webmcp.v1.schema.json",
  "title": "SecuredMe WebMCP manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifestVersion", "product", "boundaries", "tools"],
  "properties": {
    "schema": { "const": "securedme.webmcp.v1" },
    "manifestVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "product": {
      "type": "object",
      "required": ["slug", "name", "status", "canonicalStateOwner", "pagePatterns"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "enum": ["pre-alpha", "public-pre-alpha", "alpha", "beta", "stable"] },
        "canonicalStateOwner": { "type": "string", "minLength": 1, "maxLength": 64 },
        "applicationStateOwner": { "type": "string", "minLength": 1, "maxLength": 64 },
        "pagePatterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "boundaries": { "type": "object", "required": ["authority", "secrets", "externalWrites", "heroProgression"] },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "description", "mode", "availability", "inputSchema", "outputSchema", "handler"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 24, "maxLength": 500 },
          "mode": { "enum": ["READ", "STAGE", "EXECUTE"] },
          "availability": { "enum": ["available", "planned", "disabled", "forbidden"] },
          "unavailableReason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "handler": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["local", "http", "unavailable"] }, "operation": { "type": "string" }, "method": { "enum": ["GET", "POST", "PUT", "DELETE"] }, "path": { "type": "string" }, "sideEffect": { "type": "string" } } }
        }
      }
    }
  }
}

